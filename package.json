{
  "name": "ghostjob-shield",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test src/lib/analysis.test.ts src/lib/cinema.test.ts server/*.test.ts",
    "test:live": "node --env-file=.env --import tsx scripts/live-smoke.ts",
    "resume:indeed": "node --env-file=.env --import tsx scripts/resume-indeed.ts",
    "prepare:video": "node scripts/prepare-video.mjs",
    "format": "prettier --write src index.html vite.config.ts tailwind.config.js"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "gsap": "^3.13.0",
    "ipaddr.js": "^2.5.0",
    "lenis": "^1.3.17",
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
