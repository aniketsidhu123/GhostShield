# Server-only. Never prefix this with VITE_ or commit your .env file.
TINYFISH_API_KEY=
# Optional server-only Indeed fallback, used only after TinyFish cannot read that job.
BRIGHT_DATA_API_KEY=
PORT=3001
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:5173
DATA_DIR=.data
# Hard process-wide run budget; TinyFish Agent consumes account credits.
TINYFISH_RUNS_PER_HOUR=20
